{
  "name": "@lapismd/lapis-server",
  "version": "2.6.1",
  "private": true,
  "description": "Hosted Notes UI backed by the Lapis server",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-server.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "test:plugin-operations": "cargo build --locked -p lapis-server -p lapis-cli && node --test scripts/plugin-operations.test.mjs",
    "openapi:generate": "node scripts/openapi.mjs --write",
    "openapi:check": "node scripts/openapi.mjs --check",
    "protocol:generate": "node scripts/protocol.mjs --write",
    "protocol:check": "node scripts/protocol.mjs --check && tsc -p crates/lapis-app-protocol/tsconfig.json",
    "spec:build": "node scripts/dependency-automation/spec-policy.mjs build",
    "spec:check": "pnpm check:dependency-intake && node scripts/dependency-automation/spec-policy.mjs check && pnpm check:app-ownership && pnpm test:release-workflow",
    "spec:first": "node scripts/dependency-automation/spec-policy.mjs first",
    "spec:index": "spec-validator index",
    "spec:search": "spec-validator search",
    "spec:serve": "spec-validator serve",
    "spec:validate": "node scripts/dependency-automation/spec-policy.mjs validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "demo": "sh scripts/demo.sh",
    "test:demo": "node --test scripts/demo.test.mjs",
    "test:startup-budget": "cargo build -p lapis-server --locked && node scripts/test-startup-budget.mjs",
    "configure": "node scripts/configure.mjs",
    "release:version": "changeset version && pnpm install --lockfile-only && prettier package.json CHANGELOG.md --write",
    "release:github": "node scripts/release-github.mjs",
    "test:hosted-ui": "vite build --config web/vite.config.ts && playwright test -c web/playwright.hosted-notes.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "check": "pnpm check:dependency-intake && svelte-check --tsconfig tsconfig.json --fail-on-warnings && pnpm check:app-ownership && pnpm test:release-workflow",
    "test": "pnpm test:dependency-intake && node --test scripts/cli-distribution.test.mjs scripts/version-pr-auth.test.mjs && vitest run --project unit",
    "test:storybook": "vitest run --project storybook --no-file-parallelism",
    "check:app-ownership": "node scripts/check-app-ownership.ts",
    "validation:profile": "node scripts/prepare-profile-consumer.mjs",
    "test:hosted": "node scripts/test-hosted.mjs",
    "validate": "pnpm check && pnpm test && pnpm build && pnpm test:storybook && pnpm build-storybook && pnpm test:storybook:static && pnpm test:hosted && pnpm test:plugin-operations",
    "test:storybook:static": "playwright test -c web/playwright.storybook-static.config.ts",
    "test:release-workflow": "node --test scripts/version-pr-auth.test.mjs",
    "check:dependency-intake": "node scripts/dependency-automation/check-canonical-intake.mjs",
    "test:dependency-intake": "node --test scripts/dependency-automation/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lapis-notes/api": "^0.6.12",
    "@lapis-notes/app-profile": "^0.2.8",
    "@lapis-notes/file-explorer": "^0.2.8",
    "@lapis-notes/history": "^0.5.1",
    "@lapis-notes/language-service": "^0.1.6",
    "@lapis-notes/lapis-plugin-terminal": "^0.1.1",
    "@lapis-notes/markdown": "^0.3.3",
    "@lapis-notes/search": "^0.1.15",
    "@lapis-notes/source-editor": "^0.1.14",
    "@lapis-notes/ui": "^0.2.8",
    "@lapis-notes/workspace": "^0.4.10",
    "@lapismd/design-core": "^0.13.8",
    "@lapismd/jj-history": "~0.1.0",
    "@lapismd/mira": "~0.2.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2",
    "@lezer/markdown": "^1.4.3",
    "@lucide/svelte": "^0.523.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@lapis-notes/lapis-plugin-tasks": "^0.2.1",
    "@lapismd/spec-validator": "0.2.1",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/svelte-vite": "^10.6.5",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "storybook": "^10.6.5",
    "svelte": "5.56.10",
    "svelte-check": "4.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-93753",
        "CVE-2026-103923"
      ]
    }
  }
}
