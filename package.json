{
  "name": "@lapismd/lapis-server",
  "version": "1.0.2",
  "private": true,
  "description": "Hosted Notes UI backed by the Lapis server",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-server.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^24"
  },
  "pnpm": {
    "overrides": {
      "@lapis-notes/api>@lapismd/design-core": "0.12.3",
      "@lapis-notes/app-profile>@lapismd/design-core": "0.12.3",
      "@lapis-notes/file-explorer>@lapismd/design-core": "0.12.3",
      "@lapis-notes/ui>@lapismd/design-core": "0.12.3",
      "@lapis-notes/workspace>@lapismd/design-core": "0.12.3"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@lapis-notes/api>@lapismd/design-core": "0.12.2",
        "@lapis-notes/ui>@lapismd/design-core": "0.12.2"
      }
    }
  },
  "scripts": {
    "protocol:generate": "node scripts/protocol.mjs --write",
    "protocol:check": "node scripts/protocol.mjs --check && tsc -p crates/lapis-app-protocol/tsconfig.json",
    "spec:build": "node scripts/dependency-automation/spec-policy.mjs build",
    "spec:check": "node scripts/dependency-automation/spec-policy.mjs check && pnpm check:app-ownership",
    "spec:first": "node scripts/dependency-automation/spec-policy.mjs first",
    "spec:index": "spec-validator index",
    "spec:search": "spec-validator search",
    "spec:serve": "spec-validator serve",
    "spec:validate": "node scripts/dependency-automation/spec-policy.mjs validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "demo": "sh scripts/demo.sh",
    "test:demo": "node --test scripts/demo.test.mjs",
    "test:startup-budget": "node scripts/test-startup-budget.mjs",
    "configure": "node scripts/configure.mjs",
    "release:version": "changeset version && pnpm install --lockfile-only && prettier package.json CHANGELOG.md --write",
    "release:github": "node scripts/release-github.mjs",
    "test:hosted-ui": "vite build --config web/vite.config.ts && playwright test -c web/playwright.hosted-notes.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "check": "svelte-check --tsconfig tsconfig.json --fail-on-warnings && pnpm check:app-ownership",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook --no-file-parallelism",
    "check:app-ownership": "node scripts/check-app-ownership.ts",
    "validation:profile": "node scripts/prepare-profile-consumer.mjs",
    "test:hosted": "node scripts/test-hosted.mjs",
    "validate": "pnpm check && pnpm test && pnpm build && pnpm test:storybook && pnpm build-storybook && pnpm test:storybook:static && pnpm test:hosted",
    "test:storybook:static": "playwright test -c web/playwright.storybook-static.config.ts"
  },
  "dependencies": {
    "@lapis-notes/api": "^0.2.7",
    "@lapis-notes/file-explorer": "^0.2.3",
    "@lapis-notes/language-service": "^0.1.2",
    "@lapis-notes/markdown": "^0.2.1",
    "@lapis-notes/search": "^0.1.4",
    "@lapis-notes/source-editor": "^0.1.3",
    "@lapis-notes/ui": "^0.1.8",
    "@lapis-notes/workspace": "^0.3.5",
    "@lapismd/design-core": "^0.12.3",
    "@lapismd/jj-history": "~0.1.0",
    "@lapismd/mira": "~0.1.4",
    "@lucide/svelte": "^0.523.0",
    "fflate": "^0.8.3",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2",
    "@lapis-notes/app-profile": "^0.1.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@lezer/markdown": "^1.4.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@lapismd/spec-validator": "^0.2.0",
    "@playwright/test": "1.61.1",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/svelte-vite": "^10.6.5",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/svelte": "^5.4.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "^4.1.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.5",
    "svelte": "5.56.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "svelte-check": "4.3.1",
    "@types/node": "^24.0.0",
    "semver": "^7.8.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@lapis-notes/lapis-plugin-tasks": "^0.1.1",
    "@lapis-notes/history": "^0.2.4"
  }
}
