# Local HTTP demo. The script creates these files without overwriting them.
LAPIS_SERVER_ORIGIN=http://localhost:8787
LAPIS_SERVER_PORT=8787
LAPIS_SERVER_INSECURE_COOKIE=1
LAPIS_SERVER_BOOTSTRAP_USERNAME=owner
LAPIS_SERVER_CONFIG_FILE=./.local/demo/config.json
LAPIS_SERVER_PASSWORD_FILE=./.local/demo/bootstrap-password
