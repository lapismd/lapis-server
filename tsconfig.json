{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "web/src/**/*.ts",
    "web/src/**/*.svelte",
    "stories/**/*.ts",
    "stories/**/*.svelte",
    ".storybook/*.ts",
    "vitest*.ts",
    "web/e2e/**/*.ts",
    "web/playwright*.ts",
    "web/vite.config.ts"
  ],
  "exclude": ["node_modules", "web/dist", "storybook-static"]
}
